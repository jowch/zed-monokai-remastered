{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Monokai Remastered",
  "author": "Adapted from Ghostty's Monokai Remastered",
  "themes": [
    {
      "name": "Monokai Remastered",
      "appearance": "dark",
      "style": {
        "background": "#0c0c0c",
        "background.appearance": "opaque",
        "border": "#1a1a1a",
        "border.variant": "#1a1a1a",
        "border.focused": "#58d1eb",
        "border.selected": "#58d1eb",
        "border.transparent": "#00000000",
        "border.disabled": "#1a1a1a",

        "elevated_surface.background": "#1a1a1a",
        "surface.background": "#161616",
        "panel.background": "#0c0c0c",
        "panel.focused_border": "#58d1eb",
        "panel.indent_guide": "#1f1f1f",
        "panel.indent_guide_active": "#343434",
        "panel.indent_guide_hover": "#58d1eb",
        "pane.focused_border": "#58d1eb",
        "pane_group.border": "#1a1a1a",

        "status_bar.background": "#1a1a1a",
        "title_bar.background": "#1a1a1a",
        "title_bar.inactive_background": "#0c0c0c",
        "toolbar.background": "#0c0c0c",
        "tab_bar.background": "#0c0c0c",
        "tab.active_background": "#0c0c0c",
        "tab.inactive_background": "#161616",

        "search.match_background": "#fd971f44",
        "drop_target.background": "#58d1eb33",

        "text": "#d9d9d9",
        "text.muted": "#c4c5b5",
        "text.placeholder": "#625e4c",
        "text.disabled": "#625e4c",
        "text.accent": "#58d1eb",

        "icon": "#d9d9d9",
        "icon.muted": "#c4c5b5",
        "icon.disabled": "#625e4c",
        "icon.placeholder": "#625e4c",
        "icon.accent": "#58d1eb",

        "element.background": "#1a1a1a",
        "element.hover": "#25252544",
        "element.active": "#343434",
        "element.selected": "#343434",
        "element.disabled": "#1a1a1a",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#1a1a1a",
        "ghost_element.active": "#343434",
        "ghost_element.selected": "#343434",
        "ghost_element.disabled": "#1a1a1a",

        "scrollbar.thumb.background": "#c4c5b522",
        "scrollbar.thumb.hover_background": "#c4c5b544",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#1a1a1a",

        "link_text.hover": "#58d1eb",
        "hint": "#625e4c",
        "hint.background": "#00000000",
        "hint.border": "#00000000",

        "editor.background": "#0c0c0c",
        "editor.foreground": "#d9d9d9",
        "editor.gutter.background": "#0c0c0c",
        "editor.line_number": "#625e4c",
        "editor.active_line_number": "#f6f6ef",
        "editor.active_line.background": "#16161680",
        "editor.highlighted_line.background": "#1a1a1a",
        "editor.subheader.background": "#161616",
        "editor.indent_guide": "#1f1f1f",
        "editor.indent_guide_active": "#343434",
        "editor.wrap_guide": "#1f1f1f",
        "editor.active_wrap_guide": "#343434",
        "editor.invisible": "#343434",
        "editor.document_highlight.read_background": "#34343480",
        "editor.document_highlight.write_background": "#f4005f33",
        "editor.document_highlight.bracket_background": "#fd971f44",

        "conflict": "#fd971f",
        "conflict.background": "#fd971f22",
        "conflict.border": "#fd971f",
        "created": "#98e024",
        "created.background": "#98e02422",
        "created.border": "#98e024",
        "modified": "#e0d561",
        "modified.background": "#e0d56122",
        "modified.border": "#e0d561",
        "deleted": "#f4005f",
        "deleted.background": "#f4005f22",
        "deleted.border": "#f4005f",
        "renamed": "#58d1eb",
        "renamed.background": "#58d1eb22",
        "renamed.border": "#58d1eb",
        "hidden": "#625e4c",
        "hidden.background": "#1a1a1a",
        "hidden.border": "#1a1a1a",
        "ignored": "#625e4c",
        "ignored.background": "#1a1a1a",
        "ignored.border": "#1a1a1a",

        "error": "#f4005f",
        "error.background": "#f4005f22",
        "error.border": "#f4005f",
        "warning": "#fd971f",
        "warning.background": "#fd971f22",
        "warning.border": "#fd971f",
        "info": "#58d1eb",
        "info.background": "#58d1eb22",
        "info.border": "#58d1eb",
        "success": "#98e024",
        "success.background": "#98e02422",
        "success.border": "#98e024",
        "predictive": "#625e4c",
        "predictive.background": "#00000000",
        "predictive.border": "#00000000",
        "unreachable": "#625e4c",
        "unreachable.background": "#00000000",
        "unreachable.border": "#00000000",

        "terminal.background": "#0c0c0c",
        "terminal.foreground": "#d9d9d9",
        "terminal.bright_foreground": "#f6f6ef",
        "terminal.dim_foreground": "#c4c5b5",
        "terminal.ansi.background": "#0c0c0c",
        "terminal.ansi.black": "#1a1a1a",
        "terminal.ansi.red": "#f4005f",
        "terminal.ansi.green": "#98e024",
        "terminal.ansi.yellow": "#fd971f",
        "terminal.ansi.blue": "#9d65ff",
        "terminal.ansi.magenta": "#f4005f",
        "terminal.ansi.cyan": "#58d1eb",
        "terminal.ansi.white": "#c4c5b5",
        "terminal.ansi.bright_black": "#625e4c",
        "terminal.ansi.bright_red": "#f4005f",
        "terminal.ansi.bright_green": "#98e024",
        "terminal.ansi.bright_yellow": "#e0d561",
        "terminal.ansi.bright_blue": "#9d65ff",
        "terminal.ansi.bright_magenta": "#f4005f",
        "terminal.ansi.bright_cyan": "#58d1eb",
        "terminal.ansi.bright_white": "#f6f6ef",
        "terminal.ansi.dim_black": "#0c0c0c",
        "terminal.ansi.dim_red": "#a40040",
        "terminal.ansi.dim_green": "#67961a",
        "terminal.ansi.dim_yellow": "#a96914",
        "terminal.ansi.dim_blue": "#6c45b3",
        "terminal.ansi.dim_magenta": "#a40040",
        "terminal.ansi.dim_cyan": "#3d8fa2",
        "terminal.ansi.dim_white": "#88897e",

        "accents": [
          "#f4005f",
          "#98e024",
          "#fd971f",
          "#9d65ff",
          "#58d1eb",
          "#e0d561",
          "#f6f6ef"
        ],

        "players": [
          {
            "cursor": "#fc971f",
            "background": "#fc971f",
            "selection": "#34343480"
          },
          {
            "cursor": "#98e024",
            "background": "#98e024",
            "selection": "#98e02433"
          },
          {
            "cursor": "#58d1eb",
            "background": "#58d1eb",
            "selection": "#58d1eb33"
          },
          {
            "cursor": "#9d65ff",
            "background": "#9d65ff",
            "selection": "#9d65ff33"
          },
          {
            "cursor": "#f4005f",
            "background": "#f4005f",
            "selection": "#f4005f33"
          },
          {
            "cursor": "#e0d561",
            "background": "#e0d561",
            "selection": "#e0d56133"
          },
          {
            "cursor": "#f6f6ef",
            "background": "#f6f6ef",
            "selection": "#f6f6ef33"
          },
          {
            "cursor": "#fd971f",
            "background": "#fd971f",
            "selection": "#fd971f33"
          }
        ],

        "syntax": {
          "attribute":            { "color": "#98e024" },
          "boolean":              { "color": "#9d65ff" },
          "comment":              { "color": "#625e4c", "font_style": "italic" },
          "comment.doc":          { "color": "#625e4c", "font_style": "italic" },
          "constant":             { "color": "#9d65ff" },
          "constructor":          { "color": "#58d1eb" },
          "embedded":             { "color": "#d9d9d9" },
          "emphasis":             { "color": "#fd971f", "font_style": "italic" },
          "emphasis.strong":      { "color": "#fd971f", "font_weight": 700 },
          "enum":                 { "color": "#58d1eb" },
          "function":             { "color": "#98e024" },
          "function.builtin":     { "color": "#98e024" },
          "function.method":      { "color": "#98e024" },
          "function.special":     { "color": "#98e024" },
          "hint":                 { "color": "#625e4c", "font_style": "italic" },
          "keyword":              { "color": "#f4005f" },
          "label":                { "color": "#58d1eb" },
          "link_text":            { "color": "#fd971f", "font_style": "italic" },
          "link_uri":             { "color": "#58d1eb" },
          "number":               { "color": "#9d65ff" },
          "operator":             { "color": "#f4005f" },
          "predictive":           { "color": "#625e4c", "font_style": "italic" },
          "preproc":              { "color": "#f6f6ef" },
          "primary":              { "color": "#d9d9d9" },
          "property":             { "color": "#58d1eb" },
          "punctuation":          { "color": "#c4c5b5" },
          "punctuation.bracket":  { "color": "#c4c5b5" },
          "punctuation.delimiter":{ "color": "#c4c5b5" },
          "punctuation.list_marker": { "color": "#f4005f" },
          "punctuation.special":  { "color": "#f4005f" },
          "string":               { "color": "#e0d561" },
          "string.escape":        { "color": "#9d65ff" },
          "string.regex":         { "color": "#fd971f" },
          "string.special":       { "color": "#9d65ff" },
          "string.special.symbol":{ "color": "#9d65ff" },
          "tag":                  { "color": "#f4005f" },
          "text.literal":         { "color": "#e0d561" },
          "title":                { "color": "#98e024", "font_weight": 700 },
          "type":                 { "color": "#58d1eb", "font_style": "italic" },
          "type.builtin":         { "color": "#58d1eb", "font_style": "italic" },
          "variable":             { "color": "#d9d9d9" },
          "variable.parameter":   { "color": "#fd971f", "font_style": "italic" },
          "variable.special":     { "color": "#fd971f" },
          "variant":              { "color": "#58d1eb" }
        }
      }
    }
  ]
}
